# Replace yourdomain.com with your actual domain name
yourdomain.com {
    # Automatic HTTPS is handled by Caddy via Let's Encrypt

    # Compression
    encode gzip zstd

    # Aggressive caching for Next.js immutable static assets
    @static {
        path /_next/static/*
        path /favicon/*
        path /css/*
        path /img/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Reverse proxy to the Next.js Docker container
    reverse_proxy 127.0.0.1:3000
}
