# Grozone Landing Page (Next.js SSR standalone) — grozone.vn & www.grozone.vn
# DNS points to 157.66.101.217 (grey-cloud)
# Upstream grozone-fe is on bookforge-internal network.
# Automatic HTTPS via HTTP-01 ACME for grozone.vn and www.grozone.vn.

grozone.vn, www.grozone.vn {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	@static {
		path /_next/static/*
		path /favicon/*
		path /css/*
		path /img/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy grozone-fe:3000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 90s
			read_timeout 600s
			write_timeout 600s
		}
	}
}
