# Grozone Production Site — grozone.vn & www.grozone.vn
# Upstream grozone-fe is on bookforge-internal network.
# Automatic HTTPS via HTTP-01 ACME.
# Point DNS A records (@ and www) to 157.66.101.217.

grozone.vn, www.grozone.vn {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	@immutable_static {
		path /_next/static/*
	}
	header @immutable_static Cache-Control "public, max-age=31536000, immutable"

	@public_assets {
		path /favicon/*
		path /css/*
		path /img/*
	}
	header @public_assets Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	@scanner_probes {
		not path /.well-known/*
		path_regexp probe (?i)(?:^/\.|/\.\.(?:/|$)|/proc/self/|/etc/passwd|/wp-(?:admin|login|content|includes)(?:/|\.php|$)|/xmlrpc\.php$|/phpmyadmin(?:/|$))
	}
	@unnormalized_uri {
		vars_regexp orig_probe {http.request.orig_uri.path} (?i)(?://|/\.(?:/|$)|/\.\.(?:/|$)|%2e%2e|%2f)
	}
	respond @scanner_probes 404
	respond @unnormalized_uri 404

	reverse_proxy grozone-fe:3000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 90s
			read_timeout 600s
			write_timeout 600s
		}
	}
}
